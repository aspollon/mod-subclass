+std::optional<uint32> ScriptMgr::OnPlayerGetQuestRaceMask(Player const* player)
+{
+    uint32 mask = 0;
+    for (auto const& script : ScriptRegistry<PlayerScript>::EnabledHooks[PLAYERHOOK_ON_GET_QUEST_RACE_MASK])
+        if (script->OnPlayerGetQuestRaceMask(player, mask))
+            return mask;
+
+    return std::nullopt;
+}
+
+bool ScriptMgr::OnPlayerKeepsOwnLook(Player const* player, uint32 spellId)
+{
+    for (auto const& script : ScriptRegistry<PlayerScript>::EnabledHooks[PLAYERHOOK_ON_KEEPS_OWN_LOOK])
+        if (script->OnPlayerKeepsOwnLook(player, spellId))
+            return true;
+
+    return false;
+}
+
+void ScriptMgr::OnPlayerBeforeBoardedBy(Player* player, Unit* clicker)
+{
+    CALL_ENABLED_HOOKS(PlayerScript, PLAYERHOOK_ON_BEFORE_BOARDED_BY, script->OnPlayerBeforeBoardedBy(player, clicker));
+}
