+void ScriptMgr::OnPlayerLoadForeignSkill(Player const* player, uint16 skill, SkillRaceClassInfoEntry const*& entry)
+{
+    CALL_ENABLED_HOOKS(PlayerScript, PLAYERHOOK_ON_LOAD_FOREIGN_SKILL, script->OnPlayerLoadForeignSkill(player, skill, entry));
+}
